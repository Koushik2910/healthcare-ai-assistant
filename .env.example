# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your key:
#   Copy-Item .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Healthcare AI Assistant
APP_ENV=local

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# Logs user messages verbatim instead of redacting. Local debugging only.
LOG_USER_CONTENT=false

# --- Language model --------------------------------------------------------
# Active provider: gemini | groq | openrouter. Only the active provider's
# key is required below.
LLM_PROVIDER=gemini

# Primary provider. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback provider. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional third provider (demonstrates the abstraction; not required to
# run or grade the assignment). Uses an existing OpenRouter key if you have
# one, e.g. from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Retrieval -------------------------------------------------------------
RAG_ENABLED=true
CHROMA_COLLECTION=healthcare_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.25

# --- Safety ----------------------------------------------------------------
SAFETY_STRICT_MODE=true
MAX_INPUT_CHARS=2000

# --- Conversation state ----------------------------------------------------
MAX_HISTORY_TURNS=8
HISTORY_SUMMARY_THRESHOLD_CHARS=4000
